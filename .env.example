# ==============================================================================
# EvidenceX - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS.
# Copy this file to .env.local (frontend) and/or backend/.env (backend)
# ==============================================================================

# ==============================================================================
# 1. PUBLIC / FRONTEND-SAFE VARIABLES
# (Exposed to the browser via Next.js NEXT_PUBLIC_ prefix)
# ==============================================================================

# Application Environment (development, staging, production)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Configuration (Safe for client-side usage protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here


# ==============================================================================
# 2. PRIVATE / BACKEND-ONLY VARIABLES
# (CRITICAL SECURITY: NEVER EXPOSE TO FRONTEND OR BROWSER CODE)
# ==============================================================================

# Application & Server Environment
APP_ENV=development
APP_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_MODE=LIVE

# Supabase Admin / Service Role Access
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
# Keep strictly on backend servers. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Direct PostgreSQL Database Connection (Supabase Transaction/Session pooler or direct)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Upload Limits (in bytes)
MAX_AUDIO_SIZE_BYTES=26214400
MAX_IMAGE_SIZE_BYTES=10485760

# Speech-to-Text / Audio Configuration (Phases 3-5)
# Options: whisper, deepgram, google_stt
STT_PROVIDER=whisper
WHISPER_MODEL=base
STT_API_KEY=

# Ingestion / OCR Configuration (Phases 2-3)
OCR_ENGINE=paddleocr

# AI / ML Inference Configuration (Phases 2-4)
MODEL_NAME=cross-encoder/nli-deberta-v3-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# External Search Provider (Phases 3-5)
# Options: tavily, serper, mock
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key-here

# Fact-Check Provider (Phases 3-5)
# Options: google_factcheck, none
FACT_CHECK_PROVIDER=google_factcheck
FACT_CHECK_API_KEY=your-factcheck-api-key-here
